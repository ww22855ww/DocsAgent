<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Mock Portal</title>
    <style>
        body { font-family: "Segoe UI", system-ui, sans-serif; margin: 0; background: #f4f5f7; color: #1f2430; }
        header { background: #26334d; color: #fff; padding: 14px 22px; font-weight: 600; }
        main { padding: 28px 22px; }
        code { background: #e6e8ec; padding: 2px 6px; border-radius: 4px; }
    </style>
</head>
<body>
    <header>ECS Internal Document Portal</header>
    <main>@RenderBody()</main>
</body>
</html>
