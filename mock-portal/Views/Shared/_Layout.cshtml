@using MockPortal.Infrastructure
@{
    var user = Context.Session.GetString(RequireLoginAttribute.SessionKey);
    var signedIn = !string.IsNullOrEmpty(user);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · ECS Document Portal</title>
    <link rel="stylesheet" href="~/css/portal.css" />
</head>
<body>
    <header id="topbar">
        <span class="brand">ECS Internal Document Portal</span>
        @if (signedIn)
        {
            <span class="user">
                <span id="current-user">@user</span>
                <a id="link-logout" href="/Account/Logout">Sign out</a>
            </span>
        }
    </header>

    <div class="shell">
        @if (signedIn)
        {
            <nav id="sidebar">
                <div class="nav-group">Supply Chain</div>
                <a id="menu-documents" class="nav-item active" href="/Documents/Query">Document Query</a>
                <a id="menu-suppliers" class="nav-item disabled" href="#">Supplier Master</a>
                <a id="menu-po" class="nav-item disabled" href="#">Purchase Orders</a>
                <div class="nav-group">Quality</div>
                <a id="menu-iqc" class="nav-item disabled" href="#">IQC Records</a>
            </nav>
        }
        <main id="content">@RenderBody()</main>
    </div>
</body>
</html>
